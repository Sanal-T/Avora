# Application Environment (development | testing | production)
APP_NAME=Avora ERP API
APP_ENV=development

# Database Connection URL (PostgreSQL sync driver psycopg2 or sqlite fallback)
# For remote/LAN teammate machine: postgresql+psycopg2://postgres:postgres@192.168.1.88:5432/avora
# For local Docker / Postgres: postgresql+psycopg2://avora:avora@localhost:5432/avora
# For SQLite local development fallback: sqlite:///./avora.db
DATABASE_URL=postgresql+psycopg2://avora:avora@localhost:5432/avora

# Allowed CORS Origins (comma-separated list of client URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security and Authentication
# IMPORTANT: In production, SECRET_KEY and ADMIN_PASSWORD must be overridden with secure values.
SECRET_KEY=avora-super-secret-development-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Seeding Credentials
ADMIN_EMAIL=admin@avora.io
ADMIN_PASSWORD=Admin@123456
