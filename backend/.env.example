# Application Environment (development | testing | production)
APP_NAME=Avora ERP API
APP_ENV=development

# Database Connection URL (PostgreSQL sync driver psycopg2 or sqlite fallback)
# Production PostgreSQL example: postgresql+psycopg2://<db_user>:<db_password>@<db_host>:5432/<db_name>
# Local Docker / Postgres: postgresql+psycopg2://avora:avora@localhost:5432/avora
# SQLite local development fallback: sqlite:///./avora.db
DATABASE_URL=postgresql+psycopg2://avora:avora@localhost:5432/avora

# Allowed CORS Origins (comma-separated list of client URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security and Authentication
# IMPORTANT: In production, generate a strong random 32+ character key (e.g. `openssl rand -hex 32`)
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Seeding Credentials (Used during initial DB bootstrap)
ADMIN_EMAIL=admin@avora.io
ADMIN_PASSWORD=SetAStrongInitialAdminPasswordHere!
